#!/bin/sh

set -x

# hardcoded in gvisor-tap-vsock
VPNKIT_GATEWAY_IP=${VPNKIT_GATEWAY_IP:-192.168.127.1}
VPNKIT_HOST_IP=${VPNKIT_HOST_IP:-192.168.127.254}
VPNKIT_LOCAL_IP=${VPNKIT_LOCAL_IP:-192.168.127.2}
TAP_MAC_ADDR=${TAP_MAC_ADDR:-5a:94:ef:e4:0c:ee}
VPNKIT_SUBNET_MASK=${VPNKIT_SUBNET_MASK:-24}

# overrideable with env
VMEXEC_PATH=${VMEXEC_PATH:-$(command -v wsl-vm 2>/dev/null)}
GVPROXY_PATH=${GVPROXY_PATH:-$(command -v wsl-gvproxy.exe 2>/dev/null)}
GVPROXY_CONFIG=${GVPROXY_CONFIG:-}
PREEXISTING=${PREEXISTING:-1}
DHCP_TIMEOUT=${DHCP_TIMEOUT:-30}
DHCP_POLL_INTERVAL=${DHCP_POLL_INTERVAL:-1}
TAP_NAME=${TAP_NAME:-wsltap}
GVPROXY_SSH_PORT=${GVPROXY_SSH_PORT:--1}
CHECK_HOST=${CHECK_HOST:-example.com}
CHECK_DNS=${CHECK_DNS:-1.1.1.1}
DEBUG=${DEBUG:-0}

set +x

parse_config () {
    config_enabled=0
    [ -n "$GVPROXY_CONFIG" ] || return 0
    [ -f "$GVPROXY_CONFIG" ] || {
        echo "GVPROXY_CONFIG [$GVPROXY_CONFIG] does not exist"
        exit 1
    }
    [ -r "$GVPROXY_CONFIG" ] || {
        echo "GVPROXY_CONFIG [$GVPROXY_CONFIG] is not readable"
        exit 1
    }
    awk 'NF { found=1; exit } END { exit found ? 0 : 1 }' "$GVPROXY_CONFIG" ||
        return 0
    command -v yq >/dev/null 2>&1 || {
        echo "yq is required when GVPROXY_CONFIG is enabled"
        exit 1
    }

    config_enabled=1
    config_host_ip=$(yq -r '.stack.gatewayVirtualIPs[0] // ""' "$GVPROXY_CONFIG")
    [ -n "$config_host_ip" ] || {
        echo "GVPROXY_CONFIG is missing stack.gatewayVirtualIPs[0]"
        exit 1
    }
    VPNKIT_HOST_IP=$config_host_ip
    VPNKIT_GATEWAY_IP=$(yq -r '.stack.gatewayIP // ""' "$GVPROXY_CONFIG")
    [ -n "$VPNKIT_GATEWAY_IP" ] || {
        echo "GVPROXY_CONFIG is missing stack.gatewayIP"
        exit 1
    }
    config_subnet=$(yq -r '.stack.subnet // ""' "$GVPROXY_CONFIG")
    case "$config_subnet" in
        */[0-9]|*/[1-2][0-9]|*/3[0-2])
            VPNKIT_SUBNET_MASK=${config_subnet##*/}
            ;;
        *)
            echo "GVPROXY_CONFIG has an invalid stack.subnet [$config_subnet]"
            exit 1
            ;;
    esac
    VPNKIT_LOCAL_IP=$(yq -r \
        '(.stack.dhcpStaticLeases // {}) | to_entries[0].key // ""' \
        "$GVPROXY_CONFIG")
    TAP_MAC_ADDR=$(yq -r \
        '(.stack.dhcpStaticLeases // {}) | to_entries[0].value // ""' \
        "$GVPROXY_CONFIG")
    [ -n "$VPNKIT_LOCAL_IP" ] || {
        echo "GVPROXY_CONFIG is missing the DHCP static lease address"
        exit 1
    }
    [ -n "$TAP_MAC_ADDR" ] || {
        echo "GVPROXY_CONFIG is missing stack.dhcpStaticLeases"
        exit 1
    }
}

case "$PREEXISTING" in
    0|1) ;;
    *) echo "PREEXISTING must be 0 or 1"; exit 1 ;;
esac

parse_config

# WSL2 default values
WSL2_DEFAULT_ROUTE_JSON="$(ip -j route show default 2>/dev/null)"
if [ -n "$WSL2_DEFAULT_ROUTE_JSON" ] && [ "$WSL2_DEFAULT_ROUTE_JSON" != "[]" ]; then
    WSL2_TAP_NAME_FROM_ROUTE="$(echo "$WSL2_DEFAULT_ROUTE_JSON" | jq -r '.[0].dev // empty' 2>/dev/null)"
    WSL2_GATEWAY_IP_FROM_ROUTE="$(echo "$WSL2_DEFAULT_ROUTE_JSON" | jq -r '.[0].gateway // empty' 2>/dev/null)"
fi

WSL2_TAP_NAME=${WSL2_TAP_NAME:-${WSL2_TAP_NAME_FROM_ROUTE:-eth0}}
WSL2_RESOLVCONF_DEFAULT="/mnt/wsl/resolv.conf"
if [ ! -f "$WSL2_RESOLVCONF_DEFAULT" ]; then
    WSL2_RESOLVCONF_DEFAULT="/etc/resolv.conf"
fi
WSL2_RESOLVCONF=${WSL2_RESOLVCONF:-$WSL2_RESOLVCONF_DEFAULT}
WSL2_GATEWAY_IP_FROM_RESOLVCONF="$(cat $WSL2_RESOLVCONF | awk '/^nameserver/ {print $2}')"
WSL2_GATEWAY_IP=${WSL2_GATEWAY_IP:-${WSL2_GATEWAY_IP_FROM_ROUTE:-$WSL2_GATEWAY_IP_FROM_RESOLVCONF}}

set -x

# show values
WSL2_TAP_NAME=$WSL2_TAP_NAME
WSL2_GATEWAY_IP=$WSL2_GATEWAY_IP

if [ "$DEBUG" -eq 0 ]; then
    set +x
fi

# replace calls to iptables if iptables-legacy exists
command -v iptables-legacy >/dev/null && alias iptables=iptables-legacy

run () {
    echo "starting vm and gvproxy..."
    if [ "$PREEXISTING" -eq 0 ]; then
        VM_IFACE_OPTION="-mac=$TAP_MAC_ADDR"
    else
        VM_IFACE_OPTION="-preexisting=1"
    fi
    if [ "$config_enabled" -eq 1 ]; then
        GVPROXY_SSH_PORT="-1&config=$GVPROXY_CONFIG"
    fi
    $VMEXEC_PATH \
        -url="stdio:$GVPROXY_PATH?listen-stdio=accept&ssh-port=$GVPROXY_SSH_PORT&debug=$DEBUG" \
        -iface="$TAP_NAME" \
        -stop-if-exist="" \
        "$VM_IFACE_OPTION" \
        -debug=$DEBUG &
    VM_PID=$!
    sleep 1 # wait to establish connection
    echo "started vm and gvproxy"
}

wait_for_dhcp () {
    elapsed=0
    while [ "$elapsed" -lt "$DHCP_TIMEOUT" ]; do
        kill -0 "$VM_PID" 2>/dev/null ||
            { echo "wsl-vm exited while waiting for DHCP on $TAP_NAME"; exit 1; }
        if ip -j -4 addr show dev "$TAP_NAME" |
            jq -e --arg ip "$VPNKIT_LOCAL_IP" \
            '[.[0].addr_info[]? | select(.family == "inet")] |
            length == 1 and .[0].local == $ip' >/dev/null &&
            ip -j route show default dev "$TAP_NAME" |
            jq -e --arg gateway "$VPNKIT_GATEWAY_IP" \
            '[.[] | select(.gateway == $gateway)] | length == 1' >/dev/null; then
            return 0
        fi
        sleep "$DHCP_POLL_INTERVAL"
        elapsed=$((elapsed + DHCP_POLL_INTERVAL))
    done
    echo "DHCP did not assign $VPNKIT_LOCAL_IP with gateway $VPNKIT_GATEWAY_IP within ${DHCP_TIMEOUT}s"
    exit 1
}

wsl2route_down () {
    ip route del default
}

wsl2tap_down () {
    # remove WSL2 default route
    wsl2route_down

    # setup wsl-vpnkit tap
    ip tuntap add $TAP_NAME mode tap
    ip link set dev $TAP_NAME address $TAP_MAC_ADDR
    ip link set dev $TAP_NAME up
    ip addr add $VPNKIT_LOCAL_IP/$VPNKIT_SUBNET_MASK dev $TAP_NAME
    ip route add default via $VPNKIT_GATEWAY_IP dev $TAP_NAME
}

wsl2tap_up () {
    # take down wsl-vpnkit tap
    ip link set dev $TAP_NAME down 2>/dev/null
    ip tuntap del $TAP_NAME mode tap

    # add WSL2 default route
    ip route add default via $WSL2_GATEWAY_IP dev $WSL2_TAP_NAME 2>/dev/null
}

iptables_set () {
    iptables -t nat -$1 PREROUTING -d $WSL2_GATEWAY_IP/32 -p udp -m udp --dport 53 -j DNAT --to-destination $VPNKIT_GATEWAY_IP:53
    iptables -t nat -$1 PREROUTING -d $WSL2_GATEWAY_IP/32 -p tcp -m tcp --dport 53 -j DNAT --to-destination $VPNKIT_GATEWAY_IP:53
    iptables -t nat -$1 PREROUTING -d $WSL2_GATEWAY_IP/32 -j DNAT --to-destination $VPNKIT_HOST_IP
    iptables -t nat -$1 OUTPUT -d $WSL2_GATEWAY_IP/32 -p udp -m udp --dport 53 -j DNAT --to-destination $VPNKIT_GATEWAY_IP:53
    iptables -t nat -$1 OUTPUT -d $WSL2_GATEWAY_IP/32 -p tcp -m tcp --dport 53 -j DNAT --to-destination $VPNKIT_GATEWAY_IP:53
    iptables -t nat -$1 OUTPUT -d $WSL2_GATEWAY_IP/32 -j DNAT --to-destination $VPNKIT_HOST_IP
    iptables -t nat -$1 POSTROUTING -o $TAP_NAME -j MASQUERADE
}

check_interface () {
    if ip link show dev "$TAP_NAME" 2>/dev/null |
        grep -q 'state UP'; then
        echo "check: ✔️ interface up for $TAP_NAME"
        return 0
    fi
    echo "check: ❌ interface not up for $TAP_NAME"
    return 1
}

check_route_entry () {
    route=$(ip route get "$2" 2>/dev/null) || {
        echo "check: ❌ route lookup failed for $1 ($2)"
        return 1
    }
    case " $route " in
        *" dev $TAP_NAME "*) ;;
        *)
            echo "check: ❌ route lookup for $1 ($2) does not use $TAP_NAME"
            return 1
            ;;
    esac
    echo "check: ✔️ route lookup success for $1 ($2) via $TAP_NAME"
    return 0
}

check_dns () {
    dns_type=$([ "$1" = "4" ] && echo 'A' || echo 'AAAA')
    if nslookup -timeout=5 -retry=1 -type="$dns_type" "$2" "$3" >/dev/null 2>&1; then
        echo "check: ✔️ nslookup success for $2 $dns_type using $3"
        return 0
    fi
    echo "check: ❌ nslookup fail for $2 $dns_type using $3"
    return 1
}

check_https () {
    if wget --spider -q --timeout=5 --tries=1 "$1"; then
        echo "check: ✔️ wget success for $1"
        return 0
    fi
    echo "check: ❌ wget fail for $1"
    return 1
}

check () {
    failures=0

    # ICMP is not a reliable connectivity test for gvisor-tap-vsock.
    check_interface || failures=$((failures + 1))
    check_route_entry 'WSL 2 gateway / Windows host' "$WSL2_GATEWAY_IP" || failures=$((failures + 1))
    check_route_entry 'Windows host' "$VPNKIT_HOST_IP" || failures=$((failures + 1))
    check_route_entry 'gateway' "$VPNKIT_GATEWAY_IP" || failures=$((failures + 1))
    check_route_entry 'external host / DNS server' "$CHECK_DNS" || failures=$((failures + 1))

    check_dns 4 "$CHECK_HOST" "$VPNKIT_GATEWAY_IP" || failures=$((failures + 1))
    check_dns 4 "$CHECK_HOST" "$WSL2_GATEWAY_IP" || failures=$((failures + 1))
    check_dns 4 "$CHECK_HOST" "$CHECK_DNS" || failures=$((failures + 1))
    check_dns 6 "$CHECK_HOST" "$VPNKIT_GATEWAY_IP" || failures=$((failures + 1))
    check_dns 6 "$CHECK_HOST" "$WSL2_GATEWAY_IP" || failures=$((failures + 1))
    check_dns 6 "$CHECK_HOST" "$CHECK_DNS" || failures=$((failures + 1))

    check_https "http://$CHECK_HOST" || failures=$((failures + 1))
    check_https "https://$CHECK_HOST" || failures=$((failures + 1))

    if [ "$failures" -eq 0 ]; then
        echo "check: all diagnostic checks passed"
        return 0
    fi
    echo "check: $failures diagnostic check(s) failed"
    return 1
}

cleanup () {
    iptables_set D 2>/dev/null
    wsl2tap_up
}

close () {
    echo "cleaning up..."
    cleanup
    echo "stopped wsl-vpnkit"
    kill 0
}

if [ ${EUID:-$(id -u)} -ne 0 ]; then
    echo "Please run this script as root"
    exit 1
fi
if [ ! -f "$VMEXEC_PATH" ]; then
    echo "VMEXEC_PATH [$VMEXEC_PATH] does not exist"
    exit 1
fi
if [ ! -f "$GVPROXY_PATH" ]; then
    echo "GVPROXY_PATH [$GVPROXY_PATH] does not exist"
    exit 1
fi
cat $WSL2_RESOLVCONF | grep "automatically generated by WSL" >/dev/null
if [ $? -eq 1 ]; then
    echo "resolv.conf has been modified without setting generateResolvConf"
fi
if [ ! -n "$WSL_INTEROP" ]; then
    echo "WSL interop not available"
    exit 1
fi
$GVPROXY_PATH -help 2>/dev/null
if [ $? -eq 1 ]; then
    echo "$GVPROXY_PATH is not executable due to WSL interop settings or Windows permissions"
    exit 1
fi

# trap first so close runs even if the rest of the commands fail
trap close exit
trap exit int term

# run cleanup to restore any leftover configuration changes
cleanup

if [ "$PREEXISTING" -eq 1 ]; then
    wsl2tap_down
else
    wsl2route_down
fi
run
if [ "$PREEXISTING" -eq 0 ]; then
    wait_for_dhcp
fi
iptables_set A
check || echo "check: completed with failures, continue"
wait "$VM_PID"
status=$?
wait
exit "$status"
